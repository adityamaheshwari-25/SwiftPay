# Select the production profile in Azure App Service.
SPRING_PROFILES_ACTIVE=prod

# Azure Database for MySQL Flexible Server (TLS is required).
DB_URL=jdbc:mysql://your-server.mysql.database.azure.com:3306/swiftpay?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=replace-me
DB_PASSWORD=replace-me
JPA_DDL_AUTO=update

# Comma-separated exact HTTPS origins; do not use wildcard origins.
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Azure Blob Storage. The application authenticates with managed identity.
AZURE_STORAGE_BLOB_ENDPOINT=https://your-storage-account.blob.core.windows.net
AZURE_STORAGE_BLOB_CONTAINER=kyc-documents

# Store these values in Azure Key Vault.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=10h
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-secret
